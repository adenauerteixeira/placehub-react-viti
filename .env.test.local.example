## Copie para .env.test.local (gitignored via *.local) e preencha. Usado só pelos testes de
## integração Vitest (tests/integration/) — nunca pelo app em si.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

## Login de um tenant_admin real do tenant de teste (Casah) — os testes autenticam como esse
## usuário pra chamar as funções SQL (create_sale_from_proposal, reserve_announcement, etc.)
## através das mesmas policies de RLS que o app usa.
TEST_TENANT_ADMIN_EMAIL=
TEST_TENANT_ADMIN_PASSWORD=

## Login de um corretor real vinculado a um registro em brokers (profile_id preenchido) — usado
## pro teste de cálculo de comissão, que lê o commission_percentage configurado nesse corretor.
TEST_BROKER_EMAIL=
TEST_BROKER_PASSWORD=
