# Supabase — Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Monitoramento de erros (GlitchTip ou Sentry). Opcional: sem DSN, nenhum dado
# é enviado a serviços externos. Não use uma DSN que habilite dados pessoais.
VITE_GLITCHTIP_DSN=

# Não usado em código hoje — a resolução de domínio raiz é 100% em runtime,
# via window.location.hostname (src/lib/hostname.ts). Documentado aqui só
# como referência do domínio raiz real da plataforma em produção.
VITE_ROOT_DOMAIN=placehubapp.com.br

# Resend — usado pelas Edge Functions de e-mail (não expor no client).
# Configurar como secret no Supabase (`supabase secrets set`), não aqui.
# RESEND_API_KEY=
