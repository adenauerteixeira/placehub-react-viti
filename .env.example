# Supabase — Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Domínio raiz usado para roteamento por subdomínio e cookie de sessão.
# Em desenvolvimento local, deixe em branco (cai para localhost).
VITE_ROOT_DOMAIN=placehub.app

# Resend — usado pelas Edge Functions de e-mail (não expor no client).
# Configurar como secret no Supabase (`supabase secrets set`), não aqui.
# RESEND_API_KEY=
